{
  "version": 1,
  "limits": { "maxPending": 16, "maxMessageBytes": 4096, "requestTimeoutMs": 30000 },
  "enums": {
    "Support": ["supported", "unsupported", "unknown"],
    "CameraPhase": ["idle", "starting", "live", "capturing", "recording", "stopping", "cancelling", "failed"],
    "CameraMode": ["photo", "video"],
    "LensFacing": ["back", "front"],
    "CameraAccess": ["granted", "prompt", "settings"],
    "FlashMode": ["auto", "on", "off"],
    "ErrorCode": ["UNSUPPORTED", "PERMISSION_DENIED", "BUSY", "INVALID_ARGUMENT", "UNAVAILABLE", "SAVE_FAILED", "CANCELLED", "STALE_SESSION", "STALE_CAPTURE", "PROTOCOL_MISMATCH", "TIMEOUT", "DISPOSED", "OVERLOADED"]
  },
  "records": {
    "Insets": { "top": "number", "bottom": "number", "left": "number", "right": "number" },
    "Capabilities": { "photo": "Support", "video": "Support", "rawStream": "Support", "linearVideo": "Support", "accumulation": "Support", "motion": "Support", "flash": "boolean", "switchLens": "boolean", "focus": "boolean", "minZoom": "number", "maxZoom": "number" },
    "CameraState": { "phase": "CameraPhase", "mode": "CameraMode", "lens": "LensFacing", "captureId": "string?", "durationMs": "number", "zoomRatio": "number", "flash": "FlashMode", "torch": "boolean", "active": "boolean", "access": "CameraAccess", "errorCode": "ErrorCode?", "capabilities": "Capabilities", "insets": "Insets" },
    "CaptureConfig": { "mode": "CameraMode", "lens": "LensFacing" },
    "CaptureResult": { "captureId": "string", "uri": "string", "mime": "string" },
    "CaptureRef": { "captureId": "string" },
    "CaptureEvent": { "captureId": "string", "result": "CaptureResult?", "error": "BackendError?" },
    "FocusPoint": { "x": "number", "y": "number" },
    "ZoomChange": { "factor": "number" },
    "FlashConfig": { "mode": "FlashMode", "torch": "boolean" },
    "BackendError": { "code": "ErrorCode", "message": "string", "retryable": "boolean" },
    "Empty": {}
  },
  "methods": {
    "system.connect": { "params": "Empty", "result": "CameraState" },
    "system.requestCameraAccess": { "params": "Empty", "result": "Empty" },
    "system.openGallery": { "params": "Empty", "result": "Empty" },
    "camera.capabilities": { "params": "Empty", "result": "Capabilities" },
    "camera.start": { "params": "CaptureConfig", "result": "Empty" },
    "camera.stop": { "params": "Empty", "result": "Empty" },
    "camera.takePhoto": { "params": "Empty", "result": "CaptureResult" },
    "camera.startRecording": { "params": "Empty", "result": "CaptureRef" },
    "camera.stopRecording": { "params": "CaptureRef", "result": "CaptureResult" },
    "camera.cancelCapture": { "params": "CaptureRef", "result": "Empty" },
    "camera.setFlash": { "params": "FlashConfig", "result": "Empty" },
    "camera.focus": { "params": "FocusPoint", "result": "Empty", "notification": true },
    "camera.zoomBy": { "params": "ZoomChange", "result": "Empty", "notification": true }
  }
}
